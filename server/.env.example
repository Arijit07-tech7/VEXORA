# Production: set these in Render Environment Variables.
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Persistent storage. On Render, use a Persistent Disk mounted at /var/data.
VEXORA_DATA_DIR=/var/data/vexora
VEXORA_UPLOADS_DIR=/var/data/vexora/uploads

# Only used if the admin does not already exist in the database.
BOOTSTRAP_ADMIN_ID=ARIJIT
BOOTSTRAP_ADMIN_NAME=Arijit
BOOTSTRAP_ADMIN_PASSWORD=change-this-on-first-deploy
BOOTSTRAP_ADMIN_EMAIL=
